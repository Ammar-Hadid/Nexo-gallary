# Copy to /etc/nexo-gallery/storage.env with mode 0600; never commit real values.
# Replace the image with a tested immutable digest from the official registry.
NEXO_OBJECT_IMAGE=minio/minio@sha256:REPLACE_WITH_VERIFIED_DIGEST
MINIO_ROOT_USER=REPLACE_WITH_RANDOM_USER
MINIO_ROOT_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
NEXO_OBJECT_DATA_DIR=/srv/nexo-gallery/objects
NEXO_OBJECT_FS_UUID=REPLACE_WITH_UNLOCKED_FILESYSTEM_UUID
