[Unit]
Description=Nexo Gallery isolated home object store
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/nexo-gallery/storage.env
ExecStartPre=/usr/bin/docker compose -f /etc/nexo-gallery/compose.storage.yaml config --quiet
ExecStart=/usr/bin/docker compose -f /etc/nexo-gallery/compose.storage.yaml up -d --no-build
ExecStop=/usr/bin/docker compose -f /etc/nexo-gallery/compose.storage.yaml stop --timeout 120
TimeoutStartSec=3min
TimeoutStopSec=150s

[Install]
WantedBy=multi-user.target
